# Development-only unit for a hosted Soma Studio. The public somadoc.art site
# is a static bundle served directly by Apache (ADR-0121) and does not use this
# unit. Adjust User/WorkingDirectory for a development host, keep the bind
# loopback-only, and let Apache/nginx terminate TLS when needed; see SECURITY.md.
[Unit]
Description=Soma Studio (all-Rust typesetting workbench)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soma
Group=soma
WorkingDirectory=/opt/soma-studio
Environment=SOMA_HOST=127.0.0.1
Environment=SOMA_PORT=7070
ExecStart=/opt/soma-studio/run.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/soma-studio

[Install]
WantedBy=multi-user.target
